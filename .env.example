# Convex deployment URL (set by init_app_project tool or npx convex dev)
VITE_CONVEX_URL=

# For local development with npx convex dev
# CONVEX_DEPLOY_KEY=

# Auth private key (RSA 2048, generated automatically)
# AUTH_PRIVATE_KEY=

# Preview mode: "true" on dev Convex deployments (enables @test.local provider)
# IS_PREVIEW=

# Shared secret for SSO tokens and admin endpoints (required; no default)
# SSO_SHARED_SECRET=

# SMTP email for auth emails (verification + password reset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Central Manager <no-reply@example.com>
